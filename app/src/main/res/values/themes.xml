<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose-hosted app. The window background is provided by Compose.
         Parent is a framework theme on purpose: inheriting
         Theme.Material3.DayNight.NoActionBar would require the
         com.google.android.material:material dependency and fails the
         AAPT2 resource link without it. -->
    <style name="Theme.SpeakDraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
